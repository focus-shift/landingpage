{
	"private": true,
	"author": "Benjamin Seber <benjamin.seber@focus-shift.de> (https://www.focus-shift.de)",
	"type": "module",
	"scripts": {
		"lint": "eslint src lib scripts .eleventy.js",
		"format:check": "prettier --check 'src/**/*.{css,html,md,svg}'",
		"check:dashes": "node scripts/check-dashes.js",
		"clean": "rm -rf $npm_package_config_outdir",
		"predev": "npm run clean",
		"dev": "concurrently 'npm:dev:*'",
		"dev:eleventy": "NODE_ENV=development eleventy --serve --port 3000",
		"dev:css": "NODE_ENV=development postcss 'src/static/css/*.css' '!src/static/css/{config,theme}.css' -d $npm_package_config_outdir/static/css --watch",
		"dev:js": "NODE_ENV=development esbuild 'src/static/js/*.js' --bundle --outdir=$npm_package_config_outdir/static/js --watch",
		"dev:jquery": "mkdir -p $npm_package_config_outdir/static/js && cp node_modules/jquery/dist/jquery.min.js $npm_package_config_outdir/static/js",
		"prebuild": "npm run clean",
		"build": "concurrently 'npm:build:*'",
		"build:eleventy": "NODE_ENV=production eleventy",
		"build:css": "NODE_ENV=production postcss 'src/static/css/*.css' '!src/static/css/{config,theme}.css' -d $npm_package_config_outdir/static/css",
		"build:js": "NODE_ENV=production esbuild 'src/static/js/*.js' --bundle --outdir=$npm_package_config_outdir/static/js --minify",
		"build:jquery": "mkdir -p $npm_package_config_outdir/static/js && cp node_modules/jquery/dist/jquery.min.js $npm_package_config_outdir/static/js",
		"check:dist": "node scripts/check-dist.js"
	},
	"config": {
		"outdir": "dist"
	},
	"dependencies": {
		"@11ty/eleventy": "3.1.6",
		"@11ty/eleventy-img": "7.0.0",
		"@11ty/eleventy-navigation": "1.0.5",
		"@11ty/eleventy-plugin-handlebars": "1.0.0",
		"@11ty/eleventy-plugin-rss": "3.1.0",
		"@eslint/js": "10.0.1",
		"@tailwindcss/postcss": "4.3.3",
		"concurrently": "10.0.5",
		"cssnano": "9.2.2",
		"date-fns": "4.4.0",
		"esbuild": "0.28.2",
		"eslint": "10.9.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.6",
		"globals": "17.13.0",
		"handlebars": "4.7.9",
		"html-minifier-terser": "7.2.0",
		"html-validate": "11.16.2",
		"http-server": "14.1.1",
		"jquery": "4.0.0",
		"klaro": "0.7.22",
		"lint-staged": "17.6.0",
		"markdown-it": "15.0.2",
		"markdown-it-anchor": "9.2.1",
		"postcss": "8.5.28",
		"postcss-cli": "12.0.0",
		"prettier": "3.9.9",
		"tailwindcss": "4.3.3"
	},
	"lint-staged": {
		"*.js": "eslint --fix",
		"*.{css,html,md,svg}": "prettier --write"
	}
}
