<!doctype html>
<html lang="de">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>
		{{#if title}}{{title}} {{/if}}
	</title>
	<meta property="og:locale" content="de_DE" />
	<meta property="og:url" content="https://focus-shift.de" />
	<meta property="og:site_name" content="focus:shift" />
	<meta property="og:title" content="{{#if title}}{{title}}{{/if}}" />
	<meta property="og:type" content="website" />
	<meta property="og:image" content="/static/uv-multidevice_sm.png" />
	{{#if description}}
		<meta property="og:description" content="{{description}}" />
		<meta name="description" content="{{description}}" />
	{{/if}}
	<link rel="apple-touch-icon" sizes="180x180" href="/static/favicons/apple-touch-icon.png">
	<link rel="icon" type="image/png" sizes="32x32" href="/static/favicons/favicon-32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="/static/favicons/favicon-16x16.png">
	<link rel="manifest" href="/static/site.webmanifest">
	<link rel="mask-icon" href="/static/favicons/safari-pinned-tab.svg" color="#5bbad5">
	<meta name="msapplication-TileColor" content="#5bbad5">
	<meta name="theme-color" content="#9b9bff" media="(prefers-color-scheme: light)">
	<meta name="theme-color" content="#50287d" media="(prefers-color-scheme: dark)">
	{{> partials/preload-fonts }}
	{{> partials/style-fonts }}
	{{> partials/google-tag-manager-head}}
	<style>
		.zammad-chat-welcome {
			display: flex;
		}
		.zammad-chat-welcome-text {
			margin-left: 3px;
		}
		/* the chat is anchored bottom left, collapsed it is the bear asking whether it can help. */
		/* selectors are doubled to win against the chat.css injected later by the zammad script */
		.zammad-chat.zammad-chat {
			left: 30px;
			right: auto;
		}
		@media only screen and (max-width: 768px) {
			.zammad-chat.zammad-chat {
				left: 0;
			}
		}
		.zammad-chat.zammad-chat:not(.zammad-chat-is-open) {
			left: 16px;
			/* stacked on top of the cookie notice while it is shown, see zammad.js */
			bottom: calc(16px + var(--cookie-notice-offset, 0px));
			width: auto;
			height: auto;
			border-radius: 0 !important;
			box-shadow: none;
			/* same size on mobile, where chat.css enlarges the chat to 16px */
			font-size: 12px !important;
		}
		.zammad-chat:not(.zammad-chat-is-open) > :not(.zammad-chat-header) {
			display: none;
		}
		.zammad-chat.zammad-chat:not(.zammad-chat-is-open) .zammad-chat-header {
			height: auto;
			padding: 0;
			/* overrides the inline background set by the zammad script */
			background: none !important;
			box-shadow: none;
			color: var(--color-lila-dark);
			line-height: normal;
			overflow: visible;
			cursor: pointer;
		}
		.zammad-chat:not(.zammad-chat-is-open) .zammad-chat-header-controls,
		.zammad-chat:not(.zammad-chat-is-open) .zammad-chat-icon {
			display: none;
		}
		.zammad-chat:not(.zammad-chat-is-open) .zammad-chat-welcome {
			/* bear on the left, speech bubble and dismiss button stacked on the right */
			position: relative;
			display: grid;
			grid-template-columns: auto auto;
			grid-template-rows: auto 1fr;
			align-items: start;
			justify-items: start;
		}
		.zammad-chat:not(.zammad-chat-is-open) .zammad-chat-welcome::before {
			content: "";
			grid-row: 1 / span 2;
			width: 7em;
			/* the circle fills the width of the svg, the feet of the bear stick out below it */
			aspect-ratio: 340 / 351;
			background: url("/static/img/baer-chat.svg") no-repeat center / contain;
		}
		.zammad-chat:not(.zammad-chat-is-open) .zammad-chat-welcome::after {
			/* shadow of the circle only, behind the bear so its feet stay unshadowed */
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			z-index: -1;
			width: 7em;
			height: 7em;
			border-radius: 50%;
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
			pointer-events: none;
		}
		.zammad-chat:not(.zammad-chat-is-open) .zammad-chat-welcome-text {
			/* speech bubble next to the head of the bear */
			position: relative;
			margin: 0.6em 0 0 0.9em;
			padding: 0.6em 1em;
			border-radius: 1em;
			background: var(--color-white);
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
			font-size: 1.25em;
			font-weight: 600;
			white-space: nowrap;
		}
		.zammad-chat:not(.zammad-chat-is-open) .zammad-chat-welcome-text::before {
			content: "";
			position: absolute;
			top: 1.1em;
			left: -0.5em;
			border-width: 0.4em 0.6em 0.4em 0;
			border-style: solid;
			border-color: transparent var(--color-white) transparent transparent;
		}
		.zammad-chat-dismiss {
			margin: 0.6em 0 0 1.1em;
			padding: 0.4em 0.9em;
			border: 0;
			border-radius: 1em;
			background: var(--color-black);
			color: var(--color-white);
			font-size: 1.05em;
			font-weight: 600;
			cursor: pointer;
		}
		.zammad-chat-is-open .zammad-chat-dismiss {
			display: none;
		}
		/* dismissed, the bear peeks around the left corner of the page. a click brings it back. */
		.zammad-chat.zammad-chat:not(.zammad-chat-is-open) {
			transform-origin: 3.5em 100%;
			transition: transform 0.5s ease;
		}
		.zammad-chat.zammad-chat.zammad-chat--peeking {
			transform: translateX(calc(-16px - 4em)) rotate(20deg);
		}
		.zammad-chat:not(.zammad-chat-is-open) :is(.zammad-chat-welcome-text, .zammad-chat-dismiss) {
			transition:
				opacity 0.3s ease,
				visibility 0.3s;
		}
		.zammad-chat--peeking :is(.zammad-chat-welcome-text, .zammad-chat-dismiss) {
			visibility: hidden;
			opacity: 0;
		}
	</style>
	<link rel="stylesheet" href="/static/css/style.css" />
	<link rel="stylesheet" href="/static/css/klaro.css" />
	{{#each stylesheets}}
	<link rel="stylesheet" href="{{this}}" />
	{{/each}}
	<script async defer data-domain="focus-shift.de" src="https://plausible.io/js/script.js"></script>
	<script type="module" src="/static/js/common.js"></script>
	<script type="module" src="/static/js/klaro.js"></script>
	<script type="module" src="/static/js/jquery.min.js"></script>
	<script type="module" src="/static/js/zammad.js"></script>
	{{#each scripts}}
		<script type="module" src="{{this}}"></script>
	{{/each}}
</head>
<body class="flex flex-col">
	{{> partials/google-tag-manager-body}}
  {{> partials/navigation active=navigation.activeItem}}
	<div id="top" class="top-anchor"></div>
	<div class="flex-1 bg-white">
		{{{ content }}}
	</div>
  {{> partials/footer }}
	{{> partials/to-top-button target="#top" }}
</body>
</html>
